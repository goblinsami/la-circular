# Copia a .env y completa con tus valores reales. .env está excluido de Git.
# Variables privadas del servidor; no deben llevar el prefijo NUXT_PUBLIC_.
NUXT_GOOGLE_SHEET_ID=
NUXT_GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Clave entre comillas dobles, con los saltos de línea representados como \n.
NUXT_GOOGLE_PRIVATE_KEY=
NUXT_CLOUDINARY_CLOUD_NAME=
NUXT_CLOUDINARY_API_KEY=
NUXT_CLOUDINARY_API_SECRET=
